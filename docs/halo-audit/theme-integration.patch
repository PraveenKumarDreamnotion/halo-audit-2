+  padding: 13px 16px !important; font-family: var(--font-body) !important; font-size: 16px !important; color: var(--text-primary) !important;
+  background: var(--cream) !important; border: 1px solid var(--border-medium) !important; border-radius: var(--radius) !important;
+}
+body.tm-blocks-page.page-id-917 .tmsa-audit-col .halo-audit input:focus { border-color: var(--olive) !important; }
+body.tm-blocks-page.page-id-917 .tmsa-audit-col .halo-audit__button { border-radius: var(--radius) !important; font-family: var(--font-body) !important; }
+/* the theme's list indent does not belong on the group-score list */
+body.tm-blocks-page.page-id-917 main#main .tmsa-audit-col ul.halo-audit__groups { padding-left: 0 !important; margin-left: 0 !important; list-style: none !important; }
+/* report on the page: the card is full width, so lay the four group scores and the findings out across it */
+@media (min-width: 901px) {
+  body.tm-blocks-page.page-id-917 .tmsa-audit-panel.tmsa-running .halo-audit__groups {
+    display: grid !important; grid-template-columns: repeat(4, 1fr) !important; gap: 16px !important; border-top: none !important;
+  }
+  body.tm-blocks-page.page-id-917 .tmsa-audit-panel.tmsa-running .halo-audit__group {
+    padding: 16px 18px !important; background: var(--cream) !important; border: 1px solid var(--border-light) !important; border-radius: var(--radius) !important;
+  }
+}
+@media (min-width: 1200px) {
+  body.tm-blocks-page.page-id-917 .tmsa-audit-panel.tmsa-running .halo-audit__findings { column-count: 2; column-gap: 48px; }
+  body.tm-blocks-page.page-id-917 .tmsa-audit-panel.tmsa-running .halo-audit__section { break-inside: avoid-column; }
+  body.tm-blocks-page.page-id-917 .tmsa-audit-panel.tmsa-running .halo-audit__section:first-child { margin-top: 0 !important; }
+}
