diff --git a/wp-content/themes/generatepress_child/assets/js/tm-competitor-analysis.js b/wp-content/themes/generatepress_child/assets/js/tm-competitor-analysis.js
index 5420bed..6104caf 100644
--- a/wp-content/themes/generatepress_child/assets/js/tm-competitor-analysis.js
+++ b/wp-content/themes/generatepress_child/assets/js/tm-competitor-analysis.js
@@ -51,6 +51,21 @@
   (function auditToggle() {
     var panel = document.querySelector('.tmca-audit-panel');
     if (!panel) { return; }
+
+    /* SEO Analyzer 2.0 (.halo-audit widget): the plugin un-hides
+       .halo-audit__results once a report is on the page and hides it again
+       when another audit starts. A failed or refused audit never un-hides it.
+       Mirror that one attribute, so the panel is full-width exactly while a
+       report is showing. No submit listener: the plugin owns the form. */
+    var results = panel.querySelector('.halo-audit__results');
+    if (results) {
+      var sync = function () { panel.classList.toggle('tmca-running', !results.hidden); };
+      new MutationObserver(sync).observe(results, { attributes: true, attributeFilter: ['hidden'] });
+      sync();
+      return;
+    }
+
+    /* SEO Analyzer 1.x widget (kept so the theme works with either version). */
     var loading = panel.querySelector('.seo-analyzer-loading');
     if (!loading) { return; }
 
